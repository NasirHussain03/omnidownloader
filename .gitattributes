# GitHub Linguist language detection overrides
# Vendor and document all frontend/static files so they are excluded from language statistics
* linguist-vendored
*.html linguist-vendored linguist-documentation
*.js linguist-vendored linguist-documentation
*.css linguist-vendored linguist-documentation

# Unvendor Python source files so Python is the primary language
*.py -linguist-vendored linguist-detectable=true
app/** -linguist-vendored linguist-detectable=true
gunicorn_conf.py -linguist-vendored linguist-detectable=true
app.py -linguist-vendored linguist-detectable=true
test_app.py -linguist-vendored linguist-detectable=true
